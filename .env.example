ARBIS_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
ARBIS_REQUEST_TIMEOUT_MS=10000
ARBIS_MAX_DATA_AGE_SECONDS=30
ARBIS_MAX_EXCHANGE_WORKERS=6
ARBIS_MIN_NET_EDGE_PCT=0.10

# Optional: override the curated default exchange list with CCXT IDs.
# ARBIS_EXCHANGES=binance,bybit,okx,kucoin,gate,bitget,mexc,cryptocom,coinbase,kraken

ARBIS_UI_PORT=8501
ARBIS_SCAN_INTERVAL=5
ARBIS_ORDER_QUANTITY=0.001

# Optional official Bybit regional API hostname; set only for your eligible jurisdiction.
# UAE users: api.bybit.ae (confirm account/service eligibility and cloud egress region first).
ARBIS_BYBIT_API_HOST=

# Binance Spot TESTNET credentials only. Never put production keys here.
ARBIS_BINANCE_TESTNET_API_KEY=
ARBIS_BINANCE_TESTNET_SECRET=
